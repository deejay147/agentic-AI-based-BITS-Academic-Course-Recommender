# All optional. Without any key the app runs in rule-based mode.
# Set ONE of these (free tiers: Gemini via Google AI Studio, Groq):
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# optional overrides
# LLM_PROVIDER=gemini          # anthropic | gemini | groq | openai (any OpenAI-compatible server)
# LLM_MODEL=                   # blank = provider default
# LLM_BASE_URL=                # only for provider=openai
